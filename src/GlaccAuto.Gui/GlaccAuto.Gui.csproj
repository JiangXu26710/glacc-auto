<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- 版本号单一来源：写入程序集信息版本（关于行与打包文件命名均由此读取） -->
    <Version>0.1.0</Version>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <!-- 固定 RID：让 TlsClient.Native.win-x64 的原生库 targets 在常规构建也拷贝 tls-client.dll -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.*" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.*" />
    <PackageReference Include="FluentAvaloniaUI" Version="2.5.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\GlaccAuto.Core\GlaccAuto.Core.csproj" />
  </ItemGroup>
  <!-- 发布时把 TLS 指纹库放到 publish 根目录（GlaccTls 探针覆盖 exe 同目录） -->
  <Target Name="CopyTlsClientToPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(OutputPath)runtimes\tls-client\win\x64\tls-client.dll"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(OutputPath)runtimes\tls-client\win\x64\tls-client.dll')" />
  </Target>
</Project>
